const ABAS={projetos:'Projetos',codigos:'Codigos',avaliacoes:'Avaliacoes',config:'Configuracao'};
const CAB={Projetos:['id','titulo','modalidade','area_tematica','data','inicio','fim','formato','local','fontes'],Codigos:['hash_codigo','habilitado','criado_em','observacao'],Avaliacoes:['id_requisicao','recibo','hash_codigo','id_projeto','c1','c2','c3','c4','nota_final','timestamp','estado'],Configuracao:['chave','valor']};
function ss_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('Configure SPREADSHEET_ID.');return SpreadsheetApp.openById(id);}
function setupSheets(){const ss=ss_();Object.keys(ABAS).forEach(k=>{let s=ss.getSheetByName(ABAS[k]);if(!s)s=ss.insertSheet(ABAS[k]);if(!s.getLastRow())s.appendRow(CAB[ABAS[k]]);});const c=ss.getSheetByName('Configuracao'),keys=c.getLastRow()>1?c.getRange(2,1,c.getLastRow()-1,1).getValues().flat():[];[['votacao_aberta','FALSE'],['periodo_inicio',''],['periodo_fim',''],['minimo_ranking','5'],['versao_catalogo','1.0']].forEach(r=>{if(!keys.includes(r[0]))c.appendRow(r);});return 'Abas criadas.';}
function sha256_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8).map(b=>(b<0?b+256:b).toString(16).padStart(2,'0')).join('');}
function config_(){return Object.fromEntries(ss_().getSheetByName('Configuracao').getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>[String(r[0]),String(r[1])]));}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function doGet(e){if(e&&e.parameter&&e.parameter.action==='ranking')return json_({ok:true,dados:getRanking()});return HtmlService.createTemplateFromFile('Index').evaluate().setTitle('Universo IF Avalia').addMetaTag('viewport','width=device-width, initial-scale=1');}
function doPost(e){try{const p=JSON.parse(e.postData.contents||'{}');if(p.action!=='avaliar')throw Error('Ação inválida.');return json_(submitVote(p));}catch(x){return json_({ok:false,erro:String(x.message||x)});}}
function submitVote(p){const req=String(p.id_requisicao||''),token=String(p.codigo||'').trim(),id=String(p.id_projeto||''),n=p.notas;if(!/^[\w-]{20,100}$/.test(req))throw Error('ID de requisição inválido.');if(token.length<16||token.length>160)throw Error('Código inválido.');if(!Array.isArray(n)||n.length!==4||n.some(x=>!Number.isInteger(x)||x<1||x>5))throw Error('Quatro notas inteiras de 1 a 5 são obrigatórias.');const hash=sha256_(token),cache=CacheService.getScriptCache(),key='rate_'+hash,tries=Number(cache.get(key)||0);if(tries>=30)throw Error('Muitas tentativas. Aguarde alguns minutos.');cache.put(key,String(tries+1),600);const lock=LockService.getScriptLock();lock.waitLock(20000);try{const ss=ss_(),cfg=config_();if(cfg.votacao_aberta!=='TRUE')throw Error('Votação fechada.');const now=new Date();if(cfg.periodo_inicio&&now<new Date(cfg.periodo_inicio))throw Error('Período de votação ainda não começou.');if(cfg.periodo_fim&&now>new Date(cfg.periodo_fim))throw Error('Período de votação encerrado.');const ps=ss.getSheetByName('Projetos').getDataRange().getValues(),cs=ss.getSheetByName('Codigos').getDataRange().getValues(),vs=ss.getSheetByName('Avaliacoes'),rows=vs.getDataRange().getValues();if(!ps.slice(1).some(r=>String(r[0])===id))throw Error('Projeto inexistente.');if(!cs.slice(1).some(r=>String(r[0])===hash&&String(r[1]).toUpperCase()==='TRUE'))throw Error('Código não autorizado.');const retry=rows.slice(1).find(r=>String(r[0])===req);if(retry){if(String(retry[2])===hash&&String(retry[3])===id)return{ok:true,recibo:String(retry[1]),repetido:true};throw Error('ID de requisição já utilizado.');}if(rows.slice(1).some(r=>String(r[2])===hash&&String(r[3])===id))throw Error('Este código já avaliou este projeto.');const score=Math.round((n[0]*.30+n[1]*.30+n[2]*.25+n[3]*.15)*100)/100,receipt='UIA-'+Utilities.getUuid().replace(/-/g,'').slice(0,16).toUpperCase();vs.appendRow([req,receipt,hash,id,...n,score,new Date(),'VALIDO']);SpreadsheetApp.flush();return{ok:true,recibo:receipt,repetido:false};}finally{lock.releaseLock();}}
function getRanking(){const ss=ss_(),min=Math.max(1,Number(config_().minimo_ranking)||5),p=ss.getSheetByName('Projetos').getDataRange().getValues().slice(1),v=ss.getSheetByName('Avaliacoes').getDataRange().getValues().slice(1).filter(r=>r[10]==='VALIDO'),a={};v.forEach(r=>{const id=String(r[3]);if(!a[id])a[id]={q:0,s:0,c:[0,0,0,0],last:null};const x=a[id];x.q++;x.s+=Number(r[8]);for(let i=0;i<4;i++)x.c[i]+=Number(r[4+i]);if(!x.last||new Date(r[9])>x.last)x.last=new Date(r[9]);});return p.map(r=>{const x=a[String(r[0])]||{q:0,s:0,c:[0,0,0,0],last:null};return{id_projeto:String(r[0]),titulo:String(r[1]),modalidade:String(r[2]),quantidade:x.q,media_final:x.q?Math.round(x.s/x.q*100)/100:null,medias_criterios:x.q?x.c.map(y=>Math.round(y/x.q*100)/100):[null,null,null,null],atualizado_em:x.last?x.last.toISOString():null,minimo:min};});}
function hashTokenParaCadastro(token){if(!token||String(token).length<16)throw Error('Use token aleatório de pelo menos 128 bits.');return sha256_(String(token).trim());}
function listarProjetosPublicos(){return ss_().getSheetByName('Projetos').getDataRange().getValues().slice(1).filter(r=>r[0]).map(r=>({id:String(r[0]),titulo:String(r[1]),modalidade:String(r[2])}));}